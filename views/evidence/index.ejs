<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="fas fa-microscope me-2 text-primary"></i>Evidence Locker</h2>
    <a href="/evidence/add" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> Log New Evidence
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Evidence Type</th>
                        <th>Associated Crime</th>
                        <th>Collected Data Snippet</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% evidence.forEach(e => { %>
                        <tr>
                            <td class="ps-4 fw-bold"><%= e.evidence_id %></td>
                            <td><span class="badge bg-secondary"><%= e.type %></span></td>
                            <td>
                                <% if(e.crime_type) { %>
                                    <div class="small fw-bold text-dark"><%= e.crime_type %></div>
                                    <div class="text-muted smaller">ID: <%= e.crime_id %></div>
                                <% } else { %>
                                    <span class="text-muted italic">Unlinked</span>
                                <% } %>
                            </td>
                            <td>
                                <div class="text-truncate" style="max-width: 300px;">
                                    <code class="small"><%= e.collected_data %></code>
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                <a href="/evidence/edit/<%= e.evidence_id %>" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/evidence/delete/<%= e.evidence_id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this evidence?')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                    <% if (evidence.length === 0) { %>
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No evidence logged.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
