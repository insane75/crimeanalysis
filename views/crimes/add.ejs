<%- include('../partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3">
                <h4 class="fw-bold mb-0">Report Cyber Crime Incident</h4>
            </div>
            <div class="card-body p-4">
                <form action="/crimes/add" method="POST">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted">CRIME ID</label>
                            <input type="number" name="crime_id" class="form-control" required>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-muted">CRIME TYPE</label>
                            <input type="text" name="type" class="form-control" placeholder="e.g. Phishing, Ransomware" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted">DESCRIPTION LEVEL</label>
                            <textarea name="description_level" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted">DATE</label>
                            <input type="date" name="date" class="form-control" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted">TIME</label>
                            <input type="time" name="time" class="form-control">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted">SEVERITY LEVEL</label>
                            <select name="severity_level" class="form-select" required>
                                <option value="Low">Low</option>
                                <option value="Medium">Medium</option>
                                <option value="High">High</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted">INCIDENT LOCATION</label>
                            <select name="location_id" class="form-select">
                                <option value="">Select Location...</option>
                                <% locations.forEach(loc => { %>
                                    <option value="<%= loc.location_id %>"><%= loc.city %>, <%= loc.state %> (<%= loc.ip_address %>)</option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a href="/crimes" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Submit Crime Report</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
