<%- include('../partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3">
                <h4 class="fw-bold mb-0">Update Incident Case #<%= crime.crime_id %></h4>
            </div>
            <div class="card-body p-4">
                <form action="/crimes/edit/<%= crime.crime_id %>" method="POST">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted">CRIME ID (Locked)</label>
                            <input type="number" class="form-control bg-light" value="<%= crime.crime_id %>" readonly>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-muted">CRIME TYPE</label>
                            <input type="text" name="type" class="form-control" value="<%= crime.type %>" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted">DESCRIPTION LEVEL</label>
                            <textarea name="description_level" class="form-control" rows="2"><%= crime.description_level %></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted">DATE</label>
                            <input type="date" name="date" class="form-control" value="<%= new Date(crime.date).toISOString().split('T')[0] %>" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted">TIME</label>
                            <input type="time" name="time" class="form-control" value="<%= crime.time %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted">SEVERITY LEVEL</label>
                            <select name="severity_level" class="form-select" required>
                                <option value="Low" <%= crime.severity_level === 'Low' ? 'selected' : '' %>>Low</option>
                                <option value="Medium" <%= crime.severity_level === 'Medium' ? 'selected' : '' %>>Medium</option>
                                <option value="High" <%= crime.severity_level === 'High' ? 'selected' : '' %>>High</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted">INCIDENT LOCATION</label>
                            <select name="location_id" class="form-select">
                                <option value="">Select Location...</option>
                                <% locations.forEach(loc => { %>
                                    <option value="<%= loc.location_id %>" <%= loc.location_id === crime.location_id ? 'selected' : '' %>><%= loc.city %>, <%= loc.state %> (<%= loc.ip_address %>)</option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a href="/crimes" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-success px-4">Update Crime Record</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
