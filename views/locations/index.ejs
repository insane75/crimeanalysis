<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="fas fa-map-marked-alt me-2 text-info"></i>Geo-Location Registry</h2>
    <a href="/locations/add" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> Add New Location
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>City</th>
                        <th>State</th>
                        <th>Country</th>
                        <th>IP / Network</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% locations.forEach(loc => { %>
                        <tr>
                            <td class="ps-4 fw-bold"><%= loc.location_id %></td>
                            <td><%= loc.city %></td>
                            <td><%= loc.state %></td>
                            <td><%= loc.country %></td>
                            <td><code class="text-primary fw-bold"><%= loc.ip_address %></code></td>
                            <td class="text-end pe-4">
                                <a href="/locations/edit/<%= loc.location_id %>" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/locations/delete/<%= loc.location_id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this location?')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                    <% if (locations.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No locations recorded.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
