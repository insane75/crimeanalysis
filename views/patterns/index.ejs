<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="fas fa-brain me-2 text-dark"></i>Threat Pattern Intelligence</h2>
    <a href="/patterns/add" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> Register New Pattern
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Pattern Type</th>
                        <th>Description</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% patterns.forEach(p => { %>
                        <tr>
                            <td class="ps-4 fw-bold"><%= p.pattern_id %></td>
                            <td><span class="badge bg-dark fw-normal px-3"><%= p.pattern_type %></span></td>
                            <td><span class="text-muted"><%= p.description %></span></td>
                            <td class="text-end pe-4">
                                <a href="/patterns/edit/<%= p.pattern_id %>" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/patterns/delete/<%= p.pattern_id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this pattern record?')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                    <% if (patterns.length === 0) { %>
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No threat patterns registered.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
