<%- include('../partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3">
                <h4 class="fw-bold mb-0">Update Pattern: <%= pattern.pattern_type %></h4>
            </div>
            <div class="card-body p-4">
                <form action="/patterns/edit/<%= pattern.pattern_id %>" method="POST">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted">PATTERN ID (Locked)</label>
                            <input type="number" class="form-control bg-light" value="<%= pattern.pattern_id %>" readonly>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-muted">PATTERN TYPE</label>
                            <input type="text" name="pattern_type" class="form-control" value="<%= pattern.pattern_type %>" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted">DESCRIPTION</label>
                            <textarea name="description" class="form-control" rows="3"><%= pattern.description %></textarea>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a href="/patterns" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-success px-4">Update Pattern</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
