<%- include('../partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3">
                <h4 class="fw-bold mb-0">Define New Threat Pattern</h4>
            </div>
            <div class="card-body p-4">
                <form action="/patterns/add" method="POST">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted">PATTERN ID</label>
                            <input type="number" name="pattern_id" class="form-control" required>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-muted">PATTERN TYPE</label>
                            <input type="text" name="pattern_type" class="form-control" placeholder="e.g. Social Engineering, Brute Force" required>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted">DESCRIPTION</label>
                            <textarea name="description" class="form-control" rows="3" placeholder="Describe the characteristics of this attack pattern..."></textarea>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a href="/patterns" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Save Pattern</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
