<%- include('partials/header') %>

<div class="hero-section text-center mb-5 py-4">
    <div class="container">
        <h1 class="display-5 fw-bold"><i class="fas fa-chart-pie me-3 text-info"></i>Pattern <span class="text-white-50">Analytics</span></h1>
        <p class="lead">Statistical insights and visualization of cyber crime data</p>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- Crime Distribution by Type -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0">Crime Distribution by Type</h5>
            </div>
            <div class="card-body p-4">
                <canvas id="crimeTypeChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Severity Analysis -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0">Severity Analysis</h5>
            </div>
            <div class="card-body p-4">
                <canvas id="severityChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Case Status Breakdown -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0">Investigation Status</h5>
            </div>
            <div class="card-body p-4">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Victim Categories -->
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0">Target Demographics</h5>
            </div>
            <div class="card-body p-4">
                <canvas id="victimChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Data from Backend
    const crimeTypes = <%- JSON.stringify(crimesByType) %>;
    const severityData = <%- JSON.stringify(crimesBySeverity) %>;
    const statusData = <%- JSON.stringify(investigationsByStatus) %>;
    const victimData = <%- JSON.stringify(victimsByOrg) %>;

    // Crime Type Chart (Bar)
    new Chart(document.getElementById('crimeTypeChart'), {
        type: 'bar',
        data: {
            labels: crimeTypes.map(row => row.type),
            datasets: [{
                label: 'Number of Incidents',
                data: crimeTypes.map(row => row.count),
                backgroundColor: 'rgba(56, 189, 248, 0.7)',
                borderColor: '#38bdf8',
                borderWidth: 1,
                borderRadius: 8
            }]
        },
        options: {
            responsive: true,
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });

    // Severity Chart (Pie)
    new Chart(document.getElementById('severityChart'), {
        type: 'doughnut',
        data: {
            labels: severityData.map(row => row.severity_level),
            datasets: [{
                data: severityData.map(row => row.count),
                backgroundColor: ['#ef4444', '#f59e0b', '#10b981'],
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom' } }
        }
    });

    // Status Chart (Bar-Horizontal)
    new Chart(document.getElementById('statusChart'), {
        type: 'bar',
        data: {
            labels: statusData.map(row => row.status),
            datasets: [{
                label: 'Investigations',
                data: statusData.map(row => row.count),
                backgroundColor: 'rgba(15, 23, 42, 0.7)',
                borderColor: '#0f172a',
                borderWidth: 1,
                borderRadius: 8
            }]
        },
        options: {
            indexAxis: 'y',
            responsive: true,
            scales: { x: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });

    // Victim Chart (Polar Area)
    new Chart(document.getElementById('victimChart'), {
        type: 'polarArea',
        data: {
            labels: victimData.map(row => row.category),
            datasets: [{
                data: victimData.map(row => row.count),
                backgroundColor: ['#6366f1', '#a855f7'],
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { position: 'bottom' } }
        }
    });
</script>

<%- include('partials/footer') %>
