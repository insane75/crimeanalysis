<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="fas fa-user-shield me-2 text-warning"></i>Victim Registry</h2>
    <a href="/victims/add" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> Register New Victim
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Name</th>
                        <th>Organization</th>
                        <th>Age</th>
                        <th>Gender</th>
                        <th>Contact</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% victims.forEach(v => { %>
                        <tr>
                            <td class="ps-4 fw-bold"><%= v.victim_id %></td>
                            <td class="fw-semibold"><%= v.name %></td>
                            <td><%= v.organization || 'Individual' %></td>
                            <td><%= v.age || 'N/A' %></td>
                            <td><%= v.gender || 'N/A' %></td>
                            <td><%= v.contact_info %></td>
                            <td class="text-end pe-4">
                                <a href="/victims/edit/<%= v.victim_id %>" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/victims/delete/<%= v.victim_id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this victim record?')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                    <% if (victims.length === 0) { %>
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No victim records found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
