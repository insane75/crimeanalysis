<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="fas fa-user-secret me-2"></i>Criminal Database</h2>
    <a href="/criminals/add" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> Add New Criminal
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Name</th>
                        <th>Alias</th>
                        <th>Age</th>
                        <th>Gender</th>
                        <th>Contact</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% criminals.forEach(criminal => { %>
                        <tr>
                            <td class="ps-4 fw-bold"><%= criminal.criminal_id %></td>
                            <td><%= criminal.name %></td>
                            <td><span class="badge bg-info text-dark"><%= criminal.alias %></span></td>
                            <td><%= criminal.age %></td>
                            <td><%= criminal.gender %></td>
                            <td><%= criminal.contact_info %></td>
                            <td class="text-end pe-4">
                                <a href="/criminals/edit/<%= criminal.criminal_id %>" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/criminals/delete/<%= criminal.criminal_id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this record?')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                    <% if (criminals.length === 0) { %>
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No criminal records found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
