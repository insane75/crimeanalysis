<%- include('../partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3">
                <h4 class="fw-bold mb-0">Record New Criminal</h4>
            </div>
            <div class="card-body p-4">
                <form action="/criminals/add" method="POST">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted">CRIMINAL ID</label>
                            <input type="number" name="criminal_id" class="form-control" required>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-muted">FULL NAME</label>
                            <input type="text" name="name" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">ALIAS / HACKER HANDLE</label>
                            <input type="text" name="alias" class="form-control">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold small text-muted">AGE</label>
                            <input type="number" name="age" class="form-control">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold small text-muted">GENDER</label>
                            <select name="gender" class="form-select">
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted">PRIMARY ADDRESS</label>
                            <input type="text" name="address" class="form-control">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold small text-muted">CONTACT INFO</label>
                            <input type="text" name="contact_info" class="form-control">
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a href="/criminals" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">Save Criminal Record</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
