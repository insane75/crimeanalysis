<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold"><i class="fas fa-search-dollar me-2 text-success"></i>Investigation Cases</h2>
    <a href="/investigations/add" class="btn btn-primary">
        <i class="fas fa-plus me-1"></i> Open New Investigation
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Status</th>
                        <th>Officer</th>
                        <th>Associated Crime</th>
                        <th>Timeframe</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% investigations.forEach(i => { %>
                        <tr>
                            <td class="ps-4 fw-bold"><%= i.investigation_id %></td>
                            <td>
                                <% if(i.status == 'Open') { %>
                                    <span class="badge bg-primary">Open</span>
                                <% } else if(i.status == 'Closed') { %>
                                    <span class="badge bg-secondary">Closed</span>
                                <% } else { %>
                                    <span class="badge bg-warning text-dark">Pending</span>
                                <% } %>
                            </td>
                            <td><i class="fas fa-user-tie text-muted me-2"></i><%= i.officer_name %></td>
                            <td>
                                <% if(i.crime_type) { %>
                                    <span class="small fw-bold text-dark"><%= i.crime_type %></span>
                                    <span class="text-muted smaller">(#<%= i.crime_id %>)</span>
                                <% } else { %>
                                    <span class="text-muted italic">No crime linked</span>
                                <% } %>
                            </td>
                            <td>
                                <div class="small fw-bold text-muted">Start: <%= new Date(i.start_date).toLocaleDateString() %></div>
                                <% if(i.end_date) { %>
                                    <div class="small fw-bold text-dark">End: <%= new Date(i.end_date).toLocaleDateString() %></div>
                                <% } else { %>
                                    <div class="small text-info italic">Ongoing</div>
                                <% } %>
                            </td>
                            <td class="text-end pe-4">
                                <a href="/investigations/edit/<%= i.investigation_id %>" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="/investigations/delete/<%= i.investigation_id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Archive this investigation?')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                    <% if (investigations.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No investigation cases on record.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
