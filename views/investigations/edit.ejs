<%- include('../partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white py-3">
                <h4 class="fw-bold mb-0">Update Case: <%= investigation.investigation_id %></h4>
            </div>
            <div class="card-body p-4">
                <form action="/investigations/edit/<%= investigation.investigation_id %>" method="POST">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold small text-muted">CASE ID (Locked)</label>
                            <input type="number" class="form-control bg-light" value="<%= investigation.investigation_id %>" readonly>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-muted">ASSIGNED OFFICER</label>
                            <input type="text" name="officer_name" class="form-control" value="<%= investigation.officer_name %>" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">STATUS</label>
                            <select name="status" class="form-select" required>
                                <option value="Open" <%= investigation.status === 'Open' ? 'selected' : '' %>>Open</option>
                                <option value="Pending" <%= investigation.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                                <option value="Closed" <%= investigation.status === 'Closed' ? 'selected' : '' %>>Closed</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">ASSOCIATED CRIME</label>
                            <select name="crime_id" class="form-select">
                                <option value="">Select Crime...</option>
                                <% crimes.forEach(c => { %>
                                    <option value="<%= c.crime_id %>" <%= c.crime_id === investigation.crime_id ? 'selected' : '' %>><%= c.type %> (#<%= c.crime_id %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">START DATE</label>
                            <input type="date" name="start_date" class="form-control" value="<%= new Date(investigation.start_date).toISOString().split('T')[0] %>" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">END DATE</label>
                            <input type="date" name="end_date" class="form-control" value="<%= investigation.end_date ? new Date(investigation.end_date).toISOString().split('T')[0] : '' %>">
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a href="/investigations" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-success px-4">Update Case</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
